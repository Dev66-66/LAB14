# Kafka / Redpanda
KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC=user-events
KAFKA_GROUP_ID=analyzer-group
KAFKA_PARTITIONS=3

# etcd
ETCD_ENDPOINTS=etcd:2379

# Arrow Flight
ARROW_FLIGHT_HOST=0.0.0.0
ARROW_FLIGHT_PORT=8815

# Python analyzer
PARQUET_OUTPUT_DIR=./data
DUCKDB_PATH=./data/events.duckdb

# Streamlit
STREAMLIT_PORT=8501
STREAMLIT_REFRESH_INTERVAL=5

# Go collector
WINDOW_SIZE_SECONDS=10
BATCH_SIZE=100
LOG_LEVEL=INFO

# Kubernetes
REPLICAS_MIN=1
REPLICAS_MAX=5
